+            try:
+                nums.append(float(part))
+            except ValueError:
+                pass
+        xs += nums[0::2]; ys += nums[1::2]
+    for circ in g.iter(f'{{{SVG_NS}}}circle'):
+        try:
+            cx, cy, r = float(circ.get('cx', 0)), float(circ.get('cy', 0)), float(circ.get('r', 0))
+            xs += [cx - r, cx + r]; ys += [cy - r, cy + r]
+        except (TypeError, ValueError):
