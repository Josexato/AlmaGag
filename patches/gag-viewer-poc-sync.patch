+        legend.add(dwg.line(start=(x, y), end=(x + 26, y), **line_attrs))
+        label = SEMANTIC_TYPE_LABELS.get(st, st)
+        legend.add(dwg.text(label, insert=(x + 32, y + 4),
+                            font_size=f'{FONT_SIZE_ZONE}px', font_family='Arial, sans-serif',
+                            fill='#3a362c'))
+        x += 58 + len(label) * 6.8
+    dwg.add(legend)
