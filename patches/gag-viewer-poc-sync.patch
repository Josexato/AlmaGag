+def _group_transform_bbox(g):
+    """
+    Bbox de un icono custom renderizado como <g transform="translate(x,y) scale(s)">
+    (factory, gear, contract, iconos SVG embebidos). Devuelve (x1,y1,x2,y2) o None.
+    """
+    tr = g.get('transform', '')
+    m = _TRANSLATE_RE.search(tr)
