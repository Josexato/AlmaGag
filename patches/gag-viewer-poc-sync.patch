+                        font_family='Arial, sans-serif', fill='#5a5648'))
+    x += 66
+    for st in order:
+        conns = by_type[st]
+        colors = {resolve_connection_color(c) for c in conns}
+        color = colors.pop() if len(colors) == 1 else SEMANTIC_CONNECTION_COLORS.get(st)
+        dashes = {_dash_for(c) for c in conns}
