{
  "_comment": "Flujo BPMN 'Activación Datacenter' (Claro Cloud) para el algoritmo hier. §I27: 5 fases (areas) con sub-layout A-H; §I30: role por nodo (color+leyenda). Gateways=decision, tareas=server, inicio/fin=document, subproceso=building. Retrabajos = back-edges (arcos de ciclo).",
  "canvas": { "width": 2400, "height": 1400 },
  "areas": [
    { "id": "F1", "label": "1 · Contratación",                 "color": "#2a6fdb", "members": ["inicio", "obtiene", "solicita_sga", "crea_sga"] },
    { "id": "F2", "label": "2 · Evaluación comercial",         "color": "#2a6fdb", "members": ["solicita_info", "generan_nintex", "data_nintex", "envia_info", "evalua_fact", "gw_aprob1", "carga_costos"] },
    { "id": "F3", "label": "3 · Evaluación financiera",        "color": "#2a6fdb", "members": ["solicita_plant", "envia_plant", "evalua_rent", "solicita_aprN", "envia_aprN", "solicita_camb", "cambia_precio", "valida_precio", "gw_precio"] },
    { "id": "F4", "label": "4 · Aprobación & SOT",             "color": "#2a6fdb", "members": ["crea_nintex_sot", "aprueba_proy", "crea_nintex_cre", "gw_aprob2", "envia_proy", "registra", "genera_sot"] },
    { "id": "F5", "label": "5 · Activación & implementación",  "color": "#2a6fdb", "members": ["asigna_adp", "coordina", "implementacion", "envia_carta", "cierra_sot", "fin"] }
  ],
  "roles": {
    "com":   { "label": "Consultor Comercial", "color": "#2a6fdb" },
    "bo":    { "label": "Back Office Corp.",    "color": "#8a5cd0" },
    "cloud": { "label": "Especialista Cloud",   "color": "#0f9d8a" },
    "fin":   { "label": "Área de Finanzas",     "color": "#c8871a" },
    "act":   { "label": "Activaciones SOT",     "color": "#c0392b" },
    "hitss": { "label": "Global Hitss",         "color": "#5a7d18" },
    "sys":   { "label": "Inicio / Fin",         "color": "#7c786d" }
  },
  "elements": [
    { "id": "inicio",          "type": "document", "label": "Inicio",                                                  "color": "lightgreen", "role": "sys" },
    { "id": "obtiene",         "type": "server",   "label": "Obtiene la aprobación del Contrato",                      "color": "lightblue",  "role": "com" },
    { "id": "solicita_sga",    "type": "server",   "label": "Solicita creación de Proyecto en SGA (Back Office)",      "color": "lightblue",  "role": "com" },
    { "id": "crea_sga",        "type": "server",   "label": "Crea Proyecto en SGA",                                    "color": "lightblue",  "role": "bo" },
    { "id": "solicita_info",   "type": "server",   "label": "Solicita Información y Costos al especialista Cloud",     "color": "lightblue",  "role": "com" },
    { "id": "generan_nintex",  "type": "server",   "label": "Generan Nintex de Requerimiento a Tecnología",           "color": "lightblue",  "role": "cloud" },
    { "id": "data_nintex",     "type": "document", "label": "Nro de Nintex, alcance y costos del proyecto",           "color": "lightyellow","role": "cloud" },
    { "id": "envia_info",      "type": "server",   "label": "Envía Información y costos del Proyecto por correo",      "color": "lightblue",  "role": "com" },
    { "id": "evalua_fact",     "type": "server",   "label": "Evalúa Factibilidad del Proyecto",                       "color": "lightblue",  "role": "com" },
    { "id": "gw_aprob1",       "type": "decision", "label": "¿Se tiene aprobación?",                                  "color": "gold",       "role": "bo" },
    { "id": "carga_costos",    "type": "server",   "label": "Carga Costos en SGA y notifica al consultor",            "color": "lightblue",  "role": "bo" },
    { "id": "solicita_plant",  "type": "server",   "label": "Solicita completar plantilla de evaluación financiera",  "color": "lightblue",  "role": "com" },
    { "id": "envia_plant",     "type": "server",   "label": "Envía plantilla de evaluación financiera",               "color": "lightblue",  "role": "fin" },
    { "id": "evalua_rent",     "type": "server",   "label": "Evalúa rentabilidad y solicita aprobación del N",        "color": "lightblue",  "role": "fin" },
    { "id": "solicita_aprN",   "type": "server",   "label": "Solicita Aprobación del N aprobador",                    "color": "lightblue",  "role": "com" },
    { "id": "envia_aprN",      "type": "server",   "label": "Envía aprobación del N aprobador",                       "color": "lightblue",  "role": "fin" },
    { "id": "solicita_camb",   "type": "server",   "label": "Solicita cambio de Precio del Proyecto",                 "color": "lightblue",  "role": "com" },
    { "id": "cambia_precio",   "type": "server",   "label": "Cambia el precio al proyecto",                           "color": "lightblue",  "role": "fin" },
    { "id": "valida_precio",   "type": "server",   "label": "Valida el cambio de precios",                            "color": "lightblue",  "role": "fin" },
    { "id": "gw_precio",       "type": "decision", "label": "¿Es correcto el precio?",                                "color": "gold",       "role": "fin" },
    { "id": "crea_nintex_sot", "type": "server",   "label": "Crea Nintex para la generación SOT",                     "color": "lightblue",  "role": "bo" },
    { "id": "aprueba_proy",    "type": "server",   "label": "Aprueba el Proyecto y notifica al consultor",            "color": "lightblue",  "role": "bo" },
    { "id": "crea_nintex_cre", "type": "server",   "label": "Crea Nintex de evaluación de Créditos",                  "color": "lightblue",  "role": "bo" },
    { "id": "gw_aprob2",       "type": "decision", "label": "¿Se tiene aprobación?",                                  "color": "gold",       "role": "bo" },
    { "id": "envia_proy",      "type": "server",   "label": "Envía Proyecto y SOT a activaciones cloud",              "color": "lightblue",  "role": "act" },
    { "id": "registra",        "type": "document", "label": "Registra Proyecto y SOT en reporte de activaciones",     "color": "lightcyan",  "role": "act" },
    { "id": "genera_sot",      "type": "server",   "label": "Genera Solicitud de Orden de Trabajo (SOT)",             "color": "lightblue",  "role": "act" },
    { "id": "asigna_adp",      "type": "server",   "label": "Asigna un Administrador de Proyecto (ADP)",              "color": "lightblue",  "role": "act" },
    { "id": "coordina",        "type": "server",   "label": "Coordina con Global Hitss la implementación",            "color": "lightblue",  "role": "hitss" },
    { "id": "implementacion",  "type": "building", "label": "Implementación del Proyecto",                            "color": "khaki",      "role": "hitss" },
    { "id": "envia_carta",     "type": "server",   "label": "Envía Carta de conformidad del servicio al cliente",    "color": "lightblue",  "role": "act" },
    { "id": "cierra_sot",      "type": "server",   "label": "Cierra la SOT",                                          "color": "lightblue",  "role": "act" },
    { "id": "fin",             "type": "document", "label": "Fin",                                                    "color": "tomato",     "role": "sys" }
  ],
  "connections": [
    { "from": "inicio",          "to": "obtiene",         "direction": "forward" },
    { "from": "obtiene",         "to": "solicita_sga",    "direction": "forward" },
    { "from": "solicita_sga",    "to": "crea_sga",        "direction": "forward" },
    { "from": "crea_sga",        "to": "solicita_info",   "direction": "forward" },
    { "from": "solicita_info",   "to": "generan_nintex",  "direction": "forward" },
    { "from": "generan_nintex",  "to": "data_nintex",     "direction": "forward" },
    { "from": "generan_nintex",  "to": "envia_info",      "direction": "forward" },
    { "from": "envia_info",      "to": "evalua_fact",     "direction": "forward" },
    { "from": "evalua_fact",     "to": "gw_aprob1",       "direction": "forward" },
    { "from": "gw_aprob1",       "to": "carga_costos",    "direction": "forward", "label": "Sí" },
    { "from": "gw_aprob1",       "to": "envia_info",      "direction": "forward", "label": "No" },
    { "from": "carga_costos",    "to": "solicita_plant",  "direction": "forward" },
    { "from": "envia_plant",     "to": "solicita_plant",  "direction": "forward" },
    { "from": "solicita_plant",  "to": "evalua_rent",     "direction": "forward" },
    { "from": "evalua_rent",     "to": "solicita_aprN",   "direction": "forward" },
    { "from": "solicita_aprN",   "to": "envia_aprN",      "direction": "forward" },
    { "from": "envia_aprN",      "to": "solicita_camb",   "direction": "forward" },
    { "from": "solicita_camb",   "to": "cambia_precio",   "direction": "forward" },
    { "from": "cambia_precio",   "to": "valida_precio",   "direction": "forward" },
    { "from": "valida_precio",   "to": "gw_precio",       "direction": "forward" },
    { "from": "gw_precio",       "to": "crea_nintex_sot", "direction": "forward", "label": "Sí" },
    { "from": "gw_precio",       "to": "cambia_precio",   "direction": "forward", "label": "No" },
    { "from": "crea_nintex_sot", "to": "aprueba_proy",    "direction": "forward" },
    { "from": "aprueba_proy",    "to": "crea_nintex_cre", "direction": "forward" },
    { "from": "crea_nintex_cre", "to": "gw_aprob2",       "direction": "forward" },
    { "from": "gw_aprob2",       "to": "envia_proy",      "direction": "forward", "label": "Sí" },
    { "from": "gw_aprob2",       "to": "crea_nintex_cre", "direction": "forward", "label": "No" },
    { "from": "envia_proy",      "to": "registra",        "direction": "forward" },
    { "from": "envia_proy",      "to": "genera_sot",      "direction": "forward" },
    { "from": "genera_sot",      "to": "asigna_adp",      "direction": "forward" },
    { "from": "asigna_adp",      "to": "coordina",        "direction": "forward" },
    { "from": "coordina",        "to": "implementacion",  "direction": "forward" },
    { "from": "implementacion",  "to": "envia_carta",     "direction": "forward" },
    { "from": "envia_carta",     "to": "cierra_sot",      "direction": "forward" },
    { "from": "cierra_sot",      "to": "fin",             "direction": "forward" }
  ]
}
