{
  "_comment": "Flujo BPMN 'Activación Datacenter' (Claro Cloud) modelado como flowchart dirigido para el algoritmo hier. Sin coordenadas: las asigna el layout. Gateways = decision (rombo); tareas = server; inicio/fin = document; loops de retrabajo = back-edges (arco de ciclo).",
  "canvas": { "width": 2400, "height": 1600 },
  "elements": [
    { "id": "inicio",          "type": "document", "label": "Inicio",                                                  "color": "lightgreen" },
    { "id": "obtiene",         "type": "server",   "label": "Obtiene la aprobación del Contrato",                      "color": "lightblue" },
    { "id": "solicita_sga",    "type": "server",   "label": "Solicita creación de Proyecto en SGA (Back Office)",      "color": "lightblue" },
    { "id": "crea_sga",        "type": "server",   "label": "Crea Proyecto en SGA",                                    "color": "lightblue" },
    { "id": "solicita_info",   "type": "server",   "label": "Solicita Información y Costos al especialista Cloud",     "color": "lightblue" },
    { "id": "generan_nintex",  "type": "server",   "label": "Generan Nintex de Requerimiento a Tecnología",           "color": "lightblue" },
    { "id": "data_nintex",     "type": "document", "label": "Nro de Nintex, alcance y costos del proyecto",           "color": "lightyellow" },
    { "id": "envia_info",      "type": "server",   "label": "Envía Información y costos del Proyecto por correo",      "color": "lightblue" },
    { "id": "evalua_fact",     "type": "server",   "label": "Evalúa Factibilidad del Proyecto",                       "color": "lightblue" },
    { "id": "gw_aprob1",       "type": "decision", "label": "¿Se tiene aprobación?",                                  "color": "gold" },
    { "id": "carga_costos",    "type": "server",   "label": "Carga Costos en SGA y notifica al consultor",            "color": "lightblue" },
    { "id": "solicita_plant",  "type": "server",   "label": "Solicita completar plantilla de evaluación financiera",  "color": "lightblue" },
    { "id": "envia_plant",     "type": "server",   "label": "Envía plantilla de evaluación financiera",               "color": "lightblue" },
    { "id": "evalua_rent",     "type": "server",   "label": "Evalúa rentabilidad y solicita aprobación del N",        "color": "lightblue" },
    { "id": "solicita_aprN",   "type": "server",   "label": "Solicita Aprobación del N aprobador",                    "color": "lightblue" },
    { "id": "envia_aprN",      "type": "server",   "label": "Envía aprobación del N aprobador",                       "color": "lightblue" },
    { "id": "solicita_camb",   "type": "server",   "label": "Solicita cambio de Precio del Proyecto",                 "color": "lightblue" },
    { "id": "cambia_precio",   "type": "server",   "label": "Cambia el precio al proyecto",                           "color": "lightblue" },
    { "id": "valida_precio",   "type": "server",   "label": "Valida el cambio de precios",                            "color": "lightblue" },
    { "id": "gw_precio",       "type": "decision", "label": "¿Es correcto el precio?",                                "color": "gold" },
    { "id": "crea_nintex_sot", "type": "server",   "label": "Crea Nintex para la generación SOT",                     "color": "lightblue" },
    { "id": "aprueba_proy",    "type": "server",   "label": "Aprueba el Proyecto y notifica al consultor",            "color": "lightblue" },
    { "id": "crea_nintex_cre", "type": "server",   "label": "Crea Nintex de evaluación de Créditos",                  "color": "lightblue" },
    { "id": "gw_aprob2",       "type": "decision", "label": "¿Se tiene aprobación?",                                  "color": "gold" },
    { "id": "envia_proy",      "type": "server",   "label": "Envía Proyecto y SOT a activaciones cloud",              "color": "lightblue" },
    { "id": "registra",        "type": "document", "label": "Registra Proyecto y SOT en reporte de activaciones",     "color": "lightcyan" },
    { "id": "genera_sot",      "type": "server",   "label": "Genera Solicitud de Orden de Trabajo (SOT)",             "color": "lightblue" },
    { "id": "asigna_adp",      "type": "server",   "label": "Asigna un Administrador de Proyecto (ADP)",              "color": "lightblue" },
    { "id": "coordina",        "type": "server",   "label": "Coordina con Global Hitss la implementación",            "color": "lightblue" },
    { "id": "implementacion",  "type": "building", "label": "Implementación del Proyecto",                            "color": "khaki" },
    { "id": "envia_carta",     "type": "server",   "label": "Envía Carta de conformidad del servicio al cliente",    "color": "lightblue" },
    { "id": "cierra_sot",      "type": "server",   "label": "Cierra la SOT",                                          "color": "lightblue" },
    { "id": "fin",             "type": "document", "label": "Fin",                                                    "color": "tomato" }
  ],
  "connections": [
    { "from": "inicio",          "to": "obtiene",         "direction": "forward" },
    { "from": "obtiene",         "to": "solicita_sga",    "direction": "forward" },
    { "from": "solicita_sga",    "to": "crea_sga",        "direction": "forward" },
    { "from": "crea_sga",        "to": "solicita_info",   "direction": "forward" },
    { "from": "solicita_info",   "to": "generan_nintex",  "direction": "forward" },
    { "from": "generan_nintex",  "to": "data_nintex",     "direction": "forward" },
    { "from": "generan_nintex",  "to": "envia_info",      "direction": "forward" },
    { "from": "envia_info",      "to": "evalua_fact",     "direction": "forward" },
    { "from": "evalua_fact",     "to": "gw_aprob1",       "direction": "forward" },
    { "from": "gw_aprob1",       "to": "carga_costos",    "direction": "forward", "label": "Sí" },
    { "from": "gw_aprob1",       "to": "envia_info",      "direction": "forward", "label": "No" },
    { "from": "carga_costos",    "to": "solicita_plant",  "direction": "forward" },
    { "from": "envia_plant",     "to": "solicita_plant",  "direction": "forward" },
    { "from": "solicita_plant",  "to": "evalua_rent",     "direction": "forward" },
    { "from": "evalua_rent",     "to": "solicita_aprN",   "direction": "forward" },
    { "from": "solicita_aprN",   "to": "envia_aprN",      "direction": "forward" },
    { "from": "envia_aprN",      "to": "solicita_camb",   "direction": "forward" },
    { "from": "solicita_camb",   "to": "cambia_precio",   "direction": "forward" },
    { "from": "cambia_precio",   "to": "valida_precio",   "direction": "forward" },
    { "from": "valida_precio",   "to": "gw_precio",       "direction": "forward" },
    { "from": "gw_precio",       "to": "crea_nintex_sot", "direction": "forward", "label": "Sí" },
    { "from": "gw_precio",       "to": "cambia_precio",   "direction": "forward", "label": "No" },
    { "from": "crea_nintex_sot", "to": "aprueba_proy",    "direction": "forward" },
    { "from": "aprueba_proy",    "to": "crea_nintex_cre", "direction": "forward" },
    { "from": "crea_nintex_cre", "to": "gw_aprob2",       "direction": "forward" },
    { "from": "gw_aprob2",       "to": "envia_proy",      "direction": "forward", "label": "Sí" },
    { "from": "gw_aprob2",       "to": "crea_nintex_cre", "direction": "forward", "label": "No" },
    { "from": "envia_proy",      "to": "registra",        "direction": "forward" },
    { "from": "envia_proy",      "to": "genera_sot",      "direction": "forward" },
    { "from": "genera_sot",      "to": "asigna_adp",      "direction": "forward" },
    { "from": "asigna_adp",      "to": "coordina",        "direction": "forward" },
    { "from": "coordina",        "to": "implementacion",  "direction": "forward" },
    { "from": "implementacion",  "to": "envia_carta",     "direction": "forward" },
    { "from": "envia_carta",     "to": "cierra_sot",      "direction": "forward" },
    { "from": "cierra_sot",      "to": "fin",             "direction": "forward" }
  ]
}
