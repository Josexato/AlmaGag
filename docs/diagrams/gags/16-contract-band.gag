    {"id": "abstract", "type": "diamond", "label": "Iface", "color": "gold", "x": 410, "y": 270},
    {"id": "ep_right", "type": "server", "label": "Impl B", "color": "lightgreen", "x": 510, "y": 270},
    {"id": "out", "type": "document", "label": "Output", "color": "lightblue", "x": 410, "y": 470}
