{
  "_comment": "Topología dual-homing con 3 ámbitos (áreas) para distribuir a lo ancho: Sede A | Transporte | Sede B. Sin coordenadas: las pone el modo areas de hier.",
  "canvas": { "width": 1600, "height": 800 },
  "areas": [
    { "id": "sedeA",  "label": "Sede A",              "color": "#4a7c1f", "members": ["rtr_int", "fw_a", "srv_a1", "srv_a2", "rtr_mplsL"] },
    { "id": "transp", "label": "Nubes de transporte", "color": "#8b2f2f", "members": ["internet", "hfc", "mpls"] },
    { "id": "sedeB",  "label": "Sede B",              "color": "#2a6fdb", "members": ["rtr_hfc", "rtr_mplsR", "srv_b1", "srv_b2"] }
  ],
  "elements": [
    { "id": "internet",   "type": "cloud",    "label": "Internet",      "color": "#8b2f2f" },
    { "id": "rtr_int",    "type": "router",   "label": "BR Internet",   "color": "#8b2f2f" },
    { "id": "fw_a",       "type": "firewall", "label": "Firewall",      "color": "tomato" },
    { "id": "srv_a1",     "type": "server",   "label": "Srv A1",        "color": "#d9d9d9" },
    { "id": "srv_a2",     "type": "server",   "label": "Srv A2",        "color": "#d9d9d9" },
    { "id": "hfc",        "type": "cloud",    "label": "INTERNET HFC",  "color": "#e6a8a3" },
    { "id": "rtr_hfc",    "type": "router",   "label": "BR HFC",        "color": "#c47c78" },
    { "id": "mpls",       "type": "cloud",    "label": "MPLS F.O.",     "color": "#8b2f2f" },
    { "id": "rtr_mplsL",  "type": "router",   "label": "BR MPLS-A",     "color": "#8b2f2f" },
    { "id": "rtr_mplsR",  "type": "router",   "label": "BR MPLS-B",     "color": "#8b2f2f" },
    { "id": "srv_b1",     "type": "server",   "label": "Srv B1",        "color": "#d9d9d9" },
    { "id": "srv_b2",     "type": "server",   "label": "Srv B2",        "color": "#d9d9d9" }
  ],
  "connections": [
    { "from": "internet",  "to": "rtr_int",   "direction": "none", "color": "#8b2f2f" },
    { "from": "rtr_int",   "to": "fw_a",      "direction": "none", "color": "#4a7c1f" },
    { "from": "fw_a",      "to": "srv_a1",    "direction": "none", "color": "#4a7c1f" },
    { "from": "srv_a1",    "to": "srv_a2",    "direction": "none", "color": "#4a7c1f" },
    { "from": "fw_a",      "to": "rtr_mplsL", "direction": "none", "color": "#4a7c1f" },
    { "from": "rtr_mplsL", "to": "mpls",      "direction": "none", "color": "#8b2f2f" },
    { "from": "mpls",      "to": "rtr_mplsR", "direction": "none", "color": "#8b2f2f" },
    { "from": "internet",  "to": "hfc",       "direction": "none", "color": "#e6a8a3" },
    { "from": "hfc",       "to": "rtr_hfc",   "direction": "none", "color": "#e6a8a3" },
    { "from": "rtr_hfc",   "to": "srv_b1",    "direction": "none", "color": "#c0392b", "style": "dashed" },
    { "from": "rtr_hfc",   "to": "srv_b2",    "direction": "none", "color": "#c0392b", "style": "dashed" },
    { "from": "rtr_mplsR", "to": "srv_b1",    "direction": "none", "color": "#8b2f2f" },
    { "from": "rtr_mplsR", "to": "srv_b2",    "direction": "none", "color": "#8b2f2f" },
    { "from": "srv_b1",    "to": "srv_b2",    "direction": "none", "color": "#4a7c1f" }
  ]
}
