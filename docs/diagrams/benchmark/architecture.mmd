%%{init: {'theme':'base', 'themeVariables': {'fontFamily': 'sans-serif', 'fontSize': '14px'}, 'flowchart': {'htmlLabels': true, 'curve': 'basis'}} }%%
flowchart TD
    %% =====================================================
    %% Same scope as docs/diagrams/svgs/05-arquitectura-gag.svg
    %% Rendered with Mermaid (dagre auto-layout) for benchmark.
    %% Reflects current architecture post WISH-ARCH-001/002 +
    %% BUGS-LAF-002 + BUGS-LAYOUT-001/002 (2026-06-18).
    %% =====================================================

    input[(archivo<br/>.sdjf/.gag)]:::io
    main[main.py<br/><i>CLI + argparse</i>]:::server
    generator["generator.py<br/><i>OPTIMIZERS = {auto, laf}</i><br/>187 líneas"]:::factory
    contract>"LayoutOptimizer<br/><i>clase base abstracta</i>"]:::contract

    %% AUTO algorithm — self-contained
    subgraph autobox["🅰️ AUTO"]
        direction TB
        auto_opt["AutoLayoutOptimizer<br/><i>híbrido + hill climbing</i>"]:::optimizer
        auto_rend["AutoSVGRenderer<br/><i>icono inline</i>"]:::renderer
    end

    %% LAF algorithm — self-contained, 11 + 1.5 phases
    subgraph lafbox["🅻 LAF"]
        direction TB
        laf_opt["LAFOptimizer<br/><i>self-contained</i>"]:::optimizer
        laf_pipe["Pipeline LAF<br/><i>11 fases + 1.5 dashboard reflow</i><br/><i>(Sugiyama)</i>"]:::pipeline
        laf_rend["LAFSVGRenderer<br/><i>icono separado + NdFn</i>"]:::renderer
    end

    %% Shared algorithm-agnostic infrastructure
    subgraph shared["🔧 Shared (algoritmo-agnóstico)"]
        direction LR
        layout_obj[("Layout<br/><i>Value Object inmutable</i>")]:::data
        draw_svg["draw/svg.py<br/><i>primitivas SVG<br/>(create_canvas, markers,<br/>ndfn_wrap, draw_connections)</i>"]:::toolbox
        router_mgr[ConnectionRouterManager<br/><i>routing/router_manager.py</i>]:::utility
        geometry_utils[Geometry + Collision<br/>+ GraphAnalyzer<br/>+ LabelOptimizer]:::utility
    end

    output[(archivo<br/>.svg)]:::io

    %% ------- Main flow -------
    input --> main
    main --> generator

    %% Factory dispatches by --layout-algorithm
    generator -- "OPTIMIZERS['auto']" --> auto_opt
    generator -- "OPTIMIZERS['laf']" --> laf_opt

    %% Both optimizers inherit from LayoutOptimizer (contract)
    auto_opt -. "hereda" .-> contract
    laf_opt -. "hereda" .-> contract

    %% LAF pipeline composition
    laf_opt --> laf_pipe

    %% Each optimizer owns its renderer (WISH-ARCH-002)
    auto_opt --> auto_rend
    laf_pipe --> laf_rend

    %% Routing — shared between algos
    auto_opt -- "paths" --> router_mgr
    laf_pipe -- "Fase 10" --> router_mgr

    %% Renderers use shared SVG primitives
    auto_rend --> draw_svg
    laf_rend --> draw_svg

    %% Output chain
    auto_rend --> output
    laf_rend --> output

    %% Class styles
    classDef server fill:#b1f3b1,stroke:#64a664,color:#000,stroke-width:1.5px
    classDef factory fill:#ffe34c,stroke:#b29600,color:#000,stroke-width:1.8px
    classDef contract fill:#e5d4ff,stroke:#7a4cb2,color:#000,stroke-width:1.5px,stroke-dasharray:5 3
    classDef optimizer fill:#c5e3ed,stroke:#7997a1,color:#000,stroke-width:1.5px
    classDef renderer fill:#b1f3b1,stroke:#64a664,color:#000,stroke-width:1.2px
    classDef pipeline fill:#a6e7a6,stroke:#487748,color:#000,stroke-width:1.5px
    classDef data fill:#ffc04c,stroke:#b27300,color:#000,stroke-width:1.5px
    classDef toolbox fill:#ffd9a6,stroke:#b27300,color:#000,stroke-width:1.2px
    classDef utility fill:#ffe3b3,stroke:#b27300,color:#000,stroke-width:1.2px
    classDef io fill:#fffde0,stroke:#8a8500,color:#000,stroke-width:1.5px
